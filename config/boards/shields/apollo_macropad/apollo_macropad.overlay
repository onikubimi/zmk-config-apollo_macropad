&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
        /* 以下の3行を必ず追記してください */
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
    };
};
