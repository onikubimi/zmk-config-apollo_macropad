#include "apollo_macropad.dtsi"

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
    };
};

/* 既存のラベル trackball_listener がない場合のみ必要ですが、
   前回のログで undefined と出たので、念のため定義しておきます */
/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

/* 重要：新しいノードを作らず、既存の &trackball に不足項目を流し込む */
&trackball {
    status = "okay";
    evt-type = <INPUT_EV_REL>;
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
};
