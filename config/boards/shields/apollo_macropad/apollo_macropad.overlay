#include "apollo_macropad.dtsi"

/ {
    chosen {
        zephyr,display = &oled;
    };
};

/* 1. 競合の元になる SPI0 (pro_micro_spi) を強制的に無効化する */
&pro_micro_spi {
    status = "disabled";
};

/* 2. OLED (I2C) は 0番 をそのまま使う */
&pro_micro_i2c {
    status = "okay";
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
    };
};

/* 3. トラックボールを SPI1 (空いている別のユニット) に完全に引っ越す */
&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* ラベル名を 'trackball' から変更して重複を避ける */
    trackball_peripheral: pmw3610@0 {
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/* 4. ZMKの入力リスナーを新しい定義に向ける */
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_peripheral>;
    };
};
