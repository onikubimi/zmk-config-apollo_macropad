#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };
};

// 物理レイアウト設定（ZMK Studio用）
/ {
    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        // nice!nanoの5ボタン+エンコーダー+トラックボールの配置に合わせて調整してください
        keys
            = <&key_physical_attrs 100 100   0   0  0  0  0>
            , <&key_physical_attrs 100 100 100   0  0  0  0>
            , <&key_physical_attrs 100 100 200   0  0  0  0>
            , <&key_physical_attrs 100 100 300   0  0  0  0>
            , <&key_physical_attrs 100 100 400   0  0  0  0>
            ;
    };
};

// マトリックス変換
/ {
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <1>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)>;
    };
};

// KSCAN設定 (Direct Pin)
/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW1
            , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW2
            , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW3
            , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW4
            , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW5
            ;
    };
};

// エンコーダー
/ {
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};

// トラックボール (SPI)
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,    // D5 (P0.08)
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,   // D4 (P0.06)
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;   // MOSIと同じ
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&pro_micro 7 GPIO_ACTIVE_LOW>; // D7

trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; 
        
        /* 修正箇所：cpi を res-cpi に変更 */
        res-cpi = <600>; 
        
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
        force-awake;
    };
};

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay"; // disabledからokayに変更して有効化
        device = <&trackball>;
    };
};
