#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

/* トラックボールの設定：シンプルにマウス移動のみ */
&trackball_listener {
    input-processors = <
        /* センサーの向き調整（上下が逆なら Y_INVERT、左右なら X_INVERT） */
        &zip_xy_transform (INPUT_TRANSFORM_Y_INVERT) 
    >;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                /* SW1 (右) */  &kp C_AC_COPY    // コピー
                /* SW2 (右) */  &kp C_AC_PASTE   // ペースト
                /* SW3 (左) */  &mkp RCLK        // 右クリック
                /* SW4 (左・EC12押し) */  &mkp LCLK // 左クリック
                /* SW5 (右下) */  &kp ENTER      // エンター
            >;

            /* エンコーダーは常に音量調整 */
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
