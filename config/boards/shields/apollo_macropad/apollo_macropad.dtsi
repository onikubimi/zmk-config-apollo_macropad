#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zephyr,display = &oled;
    };


    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys
           = <&key_physical_attrs 100 100 100   0   0   0   0> // SW1
           , <&key_physical_attrs 100 100 100 100   0   0   0> // SW2
           , <&key_physical_attrs 100 100   0 200   0   0   0> // SW3
           , <&key_physical_attrs 100 100   0 300   0   0   0> // SW4(兼EC11)
           , <&key_physical_attrs 100 100 100 300   0   0   0> // SW5
        ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <4>;
        map = <
                    RC(0,0) 
                    RC(0,1)
            RC(0,2)
            RC(0,3) RC(0,4)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW1 (P0.09)
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW2 (P0.10)
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW3 (P1.11)
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW4 (P1.13)
            , <&gpio0 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // SW5 (P0.03)
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // P0.02
        b-gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // P0.29
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};



&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>; // D7相当

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // D8相当
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        force-awake;
    };
};

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";
    };
};
