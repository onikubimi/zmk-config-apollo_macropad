#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zephyr,display = &oled;
    };

    // 画像の2列x4行配置を座標(x, y)で定義
    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 100 100 100   0   0   0   0> // SW1 (右1段目)
            , <&key_physical_attrs 100 100 100 100   0   0   0> // SW2 (右2段目)
            , <&key_physical_attrs 100 100   0 200   0   0   0> // SW3 (左3段目)
            , <&key_physical_attrs 100 100   0 300   0   0   0> // SW4 (左4段目/EC12)
            , <&key_physical_attrs 100 100 100 300   0   0   0> // SW5 (右4段目)
            ;
    };

    // 論理行列：画像のスイッチ位置にマッピング
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <4>;
        map = <
            /* 1段目 */           RC(0,0)  // SW1
            /* 2段目 */           RC(0,1)  // SW2
            /* 3段目 */  RC(0,2)           // SW3 (Trackballはポインティングデバイスのためここには含めない)
            /* 4段目 */  RC(0,3)  RC(0,4)  // SW4, SW5
        >;
    };

    // ダイレクトピン接続
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,0)
            , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,1)
            , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,2)
            , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,3)
            , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,4)
            ;
    };

    // エンコーダー定義
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};

// OLED (I2C) 定義
&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
    };
};

// トラックボール用 SPI Pinctrl
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
            low-power-enable;
        };
    };
};

// SPI デバイス定義 (PMW3610 トラックボール)
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&pro_micro 7 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        force-awake;
    };
};

// ZaruBall構成の入力リスナー
/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";
    };
};
