#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    // 画像の2列x4行を座標(x, y)で再現
    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 100 100 100   0   0   0   0> // SW1 (右1段目)
            , <&key_physical_attrs 100 100 100 100   0   0   0> // SW2 (右2段目)
            , <&key_physical_attrs 100 100   0 200   0   0   0> // SW3 (左3段目)
            , <&key_physical_attrs 100 100   0 300   0   0   0> // SW4 (左4段目/EC12)
            , <&key_physical_attrs 100 100 100 300   0   0   0> // SW5 (右4段目)
            ;
    };

    // 論理行列の定義：物理的な配置（2列x4行）にマッピングを合わせる
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <4>;
        map = <
            /* 段 | 左列(Col 0) | 右列(Col 1) */
            /* 1 */               RC(0,0)  // SW1
            /* 2 */               RC(0,1)  // SW2
            /* 3 */  RC(0,2)               // SW3
            /* 4 */  RC(0,3)      RC(0,4)  // SW4, SW5
        >;
    };

    // ダイレクトピン接続：SW1〜SW5の順にRC(0,0)〜RC(0,4)を割り当て
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,0) -> SW1
            , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,1) -> SW2
            , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,2) -> SW3
            , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,3) -> SW4
            , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // RC(0,4) -> SW5
            ;
    };

    // ロータリーエンコーダー定義 (SW4の位置)
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};

// トラックボール用 SPI Pinctrl
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,    // D5 (P0.08)
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,   // D4 (P0.06)
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
            low-power-enable;
        };
    };
};

// SPI デバイス定義 (PMW3610 トラックボール)
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&pro_micro 7 GPIO_ACTIVE_LOW>; // D7

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // D8
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        force-awake;
    };
};

// 入力リスナー定義
/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";
    };
};
