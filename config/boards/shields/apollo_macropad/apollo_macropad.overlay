#include "apollo_macropad.dtsi"

/* 1. 衝突している SPI0 (pro_micro_spi) をノードごと完全に無効化 */
&pro_micro_spi {
    status = "disabled";
    /delete-node/ trackball@0;
};

/* 2. トラックボールを SPI1 に配置。ラベル重複を避けるため &spi1 に直接記述 */
&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* 元のラベル 'trackball' を使わず、パス指定で競合を回避 */
    new_trackball: pmw3610@0 {
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/* 3. ZMKの入力リスナーを新しいノードに接続 */
/ {
    /* 既存のリスナーがあれば一度削除 */
    /delete-node/ trackball_listener;

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&new_trackball>;
    };

    /* OLEDの選択を確認 */
    chosen {
        zephyr,display = &oled;
    };
};

/* 4. I2C (OLED) 側が 0番 を独占できるようにする */
&pro_micro_i2c {
    status = "okay";
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        /* ...その他の設定... */
    };
};
